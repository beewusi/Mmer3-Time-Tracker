{
  "name": "mmer3-desktop",
  "productName": "Mmerℇ",
  "version": "1.0.1",
  "description": "Mmerℇ desktop app: presence checks and screenshots while clocked in",
  "author": "Belinda Ewusi",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "sh mac-helper/build.sh && electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mmer3.desktop",
    "productName": "Mmer3",
    "files": [
      "main.js",
      "preload.js",
      "wifi.js",
      "config.json",
      "build/tray.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Mmerℇ uses the camera for presence checks while you're clocked in.",
        "NSLocationUsageDescription": "Mmerℇ reads which Wi-Fi network you're on to tell whether you're in the office. Your location isn't saved.",
        "NSLocationWhenInUseUsageDescription": "Mmerℇ reads which Wi-Fi network you're on to tell whether you're in the office. Your location isn't saved.",
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "mac-helper/Mmer3Wifi.app",
          "to": "Mmer3Wifi.app"
        }
      ],
      "x64ArchFiles": "Contents/Resources/Mmer3Wifi.app/**"
    },
    "extraResources": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ]
  }
}
